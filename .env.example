# ---------------------------------------------------------------------------
# F Net Water Hub — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
#
# Generate the auth secret with:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="F Net Water Hub"

# --- Database --------------------------------------------------------------
# Host "postgres" is the Docker Compose service name. Use "localhost" when
# running the app on the host against a containerised database.
DATABASE_URL=postgresql://fnet:fnet_dev_password@localhost:5433/fnet_water_hub?schema=public

# Values used by the postgres container in docker-compose.yml
POSTGRES_USER=fnet
POSTGRES_PASSWORD=fnet_dev_password
POSTGRES_DB=fnet_water_hub
# Host port the container publishes on. 5433 by default because a Postgres
# already installed on the machine will hold 5432 and silently receive the
# connection, which then fails with an authentication error.
POSTGRES_PORT=5433

# --- Authentication --------------------------------------------------------
# Secret used to sign session cookies. MUST be replaced in every environment.
AUTH_SECRET=replace-me-with-a-32-byte-base64-secret
SESSION_MAX_AGE_DAYS=7

# --- MinIO object storage --------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=fnet_minio_admin
MINIO_SECRET_KEY=fnet_minio_dev_password
MINIO_BUCKET=fnet-water-hub

# Credentials used to bootstrap the minio container
MINIO_ROOT_USER=fnet_minio_admin
MINIO_ROOT_PASSWORD=fnet_minio_dev_password

# --- Payments --------------------------------------------------------------
# "manual" records cash, bank transfer and staff-confirmed mobile money with
# no third-party dependency. Gateway drivers require real credentials and will
# fail loudly rather than silently pretending to succeed.
PAYMENT_PROVIDER=manual
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Notifications ---------------------------------------------------------
# Only the in-app channel is enabled in Phase 1. External channels carry
# per-message charges that are excluded from the Phase 1 scope (§31).
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_WHATSAPP_ENABLED=false
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
WHATSAPP_API_KEY=

# --- Seed (development only) ----------------------------------------------
# Password assigned to every seeded demo account. Development use only.
SEED_DEFAULT_PASSWORD=Fnet@2026
