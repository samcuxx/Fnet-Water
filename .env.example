# ==============================================================================
# F NET WATER HUB — ENVIRONMENT VARIABLES SPECIFICATION (.env.example)
# ==============================================================================
# Copy this file to .env.local (for local development) or .env (for Coolify/Docker).

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# For local Docker: postgresql://fnet_user:fnet_secure_pass_2026@localhost:5432/fnet_water_db?schema=public
# For Coolify/Docker Network: postgresql://fnet_user:fnet_secure_pass_2026@db:5432/fnet_water_db?schema=public
DATABASE_URL="postgresql://fnet_user:fnet_secure_pass_2026@localhost:5432/fnet_water_db?schema=public"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH.JS & SESSION SECURITY
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random string: openssl rand -base64 32
NEXTAUTH_SECRET="fnet-water-hub-super-secret-jwt-key-2026"
# Base URL for NextAuth callbacks and session cookie validation
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. PUBLIC APP CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 4. PAYSTACK PAYMENT GATEWAY (Ghana Cedis GHS - MoMo, Card & Bank)
# ------------------------------------------------------------------------------
# Live or Test Secret Key (used server-side for transaction init & verification)
PAYSTACK_SECRET_KEY="sk_test_e3dc4308aa829bb13669f66be490fadc1d120778"
# Live or Test Public Key (used client-side for Paystack Inline checkout)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_eb0b32c0bf50b5e00420d9d175e41a082e601be4"

# ------------------------------------------------------------------------------
# 5. MNOTIFY SMS DISPATCH SERVICE (OTP & Operational Alerts)
# ------------------------------------------------------------------------------
# Registered API Key from mNotify Ghana developer console
MNOTIFY_API_KEY="EpyJqPefIbrTOBWOfr5ifgQXn"
# Registered Sender ID (Max 11 alphanumeric characters)
MNOTIFY_SENDER_ID="Fnet"
# Project identifier
MNOTIFY_PROJECT="Fnet"
